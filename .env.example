# 루트 .env : docker compose 전용 값 (서비스별 비밀값은 TP_BE/.env, TP_AI/.env, TP_BATCH/.env 에 둔다)
# cp .env.example .env

# 이미지 태그. scripts/deploy-macmini.sh 가 커밋 SHA 로 채운다
TAG=dev

# 호스트에 여는 포트 (맥미니에서 이미 쓰는 포트와 겹치면 바꾼다)
FE_PORT=80
BE_PORT=8080
AI_PORT=8000

# FE 빌드 값 (빌드할 때 번들에 들어감)
VITE_KAKAO_MAP_API_KEY=
VITE_USE_MOCK=false

# DB 접속 주소: 컨테이너 안에서 localhost 는 컨테이너 자신이라, 맥미니 호스트 DB 는 host.docker.internal 로 쓴다
# (필수) AI: 접속 정보가 URL 하나에 들어 있어 여기서 통째로 지정
AI_DATABASE_URL=postgresql+asyncpg://<user>:<password>@host.docker.internal:5432/<db>
# (선택) BE·배치: 계정·비밀번호는 각 서비스 .env 값을 쓰고 호스트만 바꾼다. 비우면 compose 기본값
# BE_DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/tour_db
# BATCH_DB_HOST=host.docker.internal
