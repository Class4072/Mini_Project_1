# App Settings
APP_NAME=TP_TRAVEL_AI
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL & pgvector Connection
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vector_db

# LLM Engine Configuration
LLM_PROVIDER=ollama # ollama | gemini | openai | mock
LLM_MODEL_NAME=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
# GEMINI_API_KEY=your_gemini_key_if_used
# OPENAI_API_KEY=your_openai_key_if_used
LLM_TIMEOUT_SECONDS=30.0

# Embedding Model Settings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=jhgan/ko-sroberta-multitask
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu # 'cpu' or 'cuda'

# Chunking Default Settings
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
