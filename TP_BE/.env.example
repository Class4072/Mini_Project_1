# 백엔드 환경변수 예시. 이 파일을 .env 로 복사해 값을 채운다 (.env 는 커밋하지 않는다).
# ./gradlew bootRun 은 TP_BE 폴더에서 .env 를 읽는다.

# DB: 앱은 tp_backend, 마이그레이션(Flyway)은 tp_owner 로 접속한다 (DATABASE.md 6장)
DATABASE_URL=jdbc:postgresql://localhost:5432/tour_db
DB_USER=tp_backend
DB_PASSWORD=
# 스키마를 바꿀 일이 없으면 false 로 꺼 두고 tp_owner 비밀번호 없이 실행해도 된다
FLYWAY_ENABLED=true
FLYWAY_USER=tp_owner
FLYWAY_PASSWORD=

# Redis (지도 마커 캐시). Redis 없이 실행하려면 CACHE_TYPE=none
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI 서비스 (TP_AI)
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_SECONDS=100

# 공유 링크 앞부분: {SHARE_BASE_URL}/{token}
SHARE_BASE_URL=http://localhost:5173/s

# MAP-003 길찾기: 카카오 REST API 키. 비우면 직선거리로 추정한다
KAKAO_MOBILITY_REST_API_KEY=
